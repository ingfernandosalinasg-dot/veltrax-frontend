# Plantilla de variables de entorno del frontend Veltrax.
#
# Vite carga automáticamente según el comando:
#   npm run dev   -> .env.development
#   npm run build -> .env.production
#
# VITE_API_URL: URL base del backend, sin "/" al final.
#   Local:      http://localhost:8081
#   Producción: https://veltrax-api-production.up.railway.app
#
# IMPORTANTE: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca pongas contraseñas, tokens ni claves de API en estas variables.

VITE_API_URL=http://localhost:8081
